    <!-- AOS Animation JS -->
    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js" is:inline></script>
    
    <script is:inline>
        // Forzar que siempre inicie arriba al cargar/recargar la página
        if ('scrollRestoration' in history) {
            history.scrollRestoration = 'manual';
        }
        window.scrollTo(0, 0);
        window.addEventListener('beforeunload', () => {
            window.scrollTo(0, 0);
        });
        document.addEventListener('DOMContentLoaded', () => {
            window.scrollTo(0, 0);
        });

        // Inicializar AOS (Animaciones al hacer scroll) con efectos fluidos y de lujo
        AOS.init({
            duration: 1500,
            once: true,
            offset: 120,
            easing: 'ease-out-quint',
            delay: 50
        });

        // -------------------------
        // LÓGICA DE AUDIO (Autoplay & Botón)
        // -------------------------
        const audio = document.getElementById('bgMusic');
        const toggleBtn = document.getElementById('musicToggle');
        const icon = document.getElementById('musicIcon');
        
        let isPlaying = false;
        let fadeInterval;

        audio.volume = 0; // Iniciar en 0 para el fade in

        // Función central para reproducir
        const playMusic = () => {
            if (isPlaying) return; // Si ya está sonando, no hacer nada

            audio.play().then(() => {
                isPlaying = true;
                icon.classList.remove('fa-play', 'pl-0.5');
                icon.classList.add('fa-pause');
                toggleBtn.classList.add('pulse-ring-music');
                
                let vol = 0;
                clearInterval(fadeInterval);
                audio.volume = 0;
                
                // Fade-in de 0 a 0.2 (20% de volumen para música de fondo suave)
                fadeInterval = setInterval(() => {
                    if (vol < 0.2) {
                        vol += 0.01;
                        audio.volume = Math.min(vol, 0.2);
                    } else {
                        clearInterval(fadeInterval);
                    }
                }, 50);
                
                // Remover listeners globales una vez que logró reproducirse
                document.body.removeEventListener('click', playMusicAnywhere);
                document.body.removeEventListener('touchstart', playMusicAnywhere);
                
            }).catch(error => {
                console.log("Autoplay bloqueado. Esperando interacción.");
            });
        };

        // Función para pausar
        const pauseMusic = () => {
            if (!isPlaying) return;
            audio.pause();
            isPlaying = false;
            icon.classList.remove('fa-pause');
            icon.classList.add('fa-play', 'pl-0.5');
            toggleBtn.classList.remove('pulse-ring-music');
        };

        // Listener del botón flotante
        toggleBtn.addEventListener('click', (e) => {
            e.stopPropagation(); // Evitar que dispare el listener del body
            if (isPlaying) {
                pauseMusic();
            } else {
                playMusic();
            }
        });

        // Wrapper para el evento en cualquier parte del body
        const playMusicAnywhere = () => {
            if (!isPlaying) {
                playMusic();
            }
        };

        // -------------------------
        // LÓGICA DE APERTURA DEL SOBRE DIGITAL
        // -------------------------
        const welcomeScreen = document.getElementById('welcomeScreen');
        const btnOpen = document.getElementById('btnOpen');
        const envelopeWrapper = document.getElementById('envelopeWrapper');
        const envelopeFlap = document.getElementById('envelopeFlap');
        const envelopeLetter = document.getElementById('envelopeLetter');
        const waxSeal = document.getElementById('waxSeal');
        const welcomeHeader = document.getElementById('welcomeHeader');
        const openBtnContainer = document.getElementById('openBtnContainer');
        
        let envelopeOpened = false;

        const openInvitationFlow = () => {
            if (envelopeOpened) return;
            envelopeOpened = true;

            // 1. Quitar el botón de abajo y el header para centrar la atención en el sobre
            if (welcomeHeader) {
                welcomeHeader.style.opacity = '0';
                welcomeHeader.style.transform = 'translateY(-20px)';
            }
            if (openBtnContainer) {
                openBtnContainer.style.opacity = '0';
                openBtnContainer.style.transform = 'translateY(20px)';
            }

            // 2. Romper el sello de lacre
            if (waxSeal) {
                waxSeal.classList.add('broken');
            }

            // 3. Abrir la solapa superior (después de 400ms para permitir ver el lacre rompiéndose)
            setTimeout(() => {
                if (envelopeFlap) {
                    envelopeFlap.classList.add('open');
                }
            }, 400);

            // 4. Sacar la carta (después de 1000ms, cuando la solapa esté completamente abierta)
            setTimeout(() => {
                if (envelopeLetter) {
                    envelopeLetter.classList.add('pull-out');
                }
            }, 1000);

            // 5. Comenzar la música y cerrar la pantalla de bienvenida
            setTimeout(() => {
                // Quitar bloqueo de scroll
                document.body.classList.remove('no-scroll');
                // Desvanecer la pantalla de bienvenida
                if (welcomeScreen) {
                    welcomeScreen.classList.add('welcome-hidden');
                }
                // Reproducir audio con fade-in
                playMusic();
            }, 2500);
        };

        if (btnOpen) {
            btnOpen.addEventListener('click', (e) => {
                e.stopPropagation();
                openInvitationFlow();
            });
        }

        if (envelopeWrapper) {
            envelopeWrapper.addEventListener('click', (e) => {
                e.stopPropagation();
                openInvitationFlow();
            });
        }

        // Fecha objetivo: 20 de Junio de 2026 a las 00:00:00
        const countDownDate = new Date("June 20, 2026 00:00:00").getTime();

        const x = setInterval(function() {
            const now = new Date().getTime();
            const distance = countDownDate - now;

            if (distance < 0) {
                clearInterval(x);
                document.getElementById("days").innerHTML = "00";
                document.getElementById("hours").innerHTML = "00";
                document.getElementById("minutes").innerHTML = "00";
                document.getElementById("seconds").innerHTML = "00";
                return;
            }

            const days = Math.floor(distance / (1000 * 60 * 60 * 24));
            const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
            const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
            const seconds = Math.floor((distance % (1000 * 60)) / 1000);

            // Formatear a 2 dígitos
            document.getElementById("days").innerHTML = days.toString().padStart(2, '0');
            document.getElementById("hours").innerHTML = hours.toString().padStart(2, '0');
            document.getElementById("minutes").innerHTML = minutes.toString().padStart(2, '0');
            document.getElementById("seconds").innerHTML = seconds.toString().padStart(2, '0');

        }, 1000);

        // -------------------------
        // INTERACTIVE CANVAS (Pétalos dorados flotando y destellos)
        // -------------------------
        const canvas = document.getElementById('particlesCanvas');
        const ctx = canvas.getContext('2d');

        let width = canvas.width = window.innerWidth;
        let height = canvas.height = window.innerHeight;

        // Mouse coordinates tracker
        const mouse = { x: -1000, y: -1000 };

        window.addEventListener('mousemove', (e) => {
            mouse.x = e.clientX;
            mouse.y = e.clientY;
        });

        window.addEventListener('mouseleave', () => {
            mouse.x = -1000;
            mouse.y = -1000;
        });

        window.addEventListener('resize', () => {
            width = canvas.width = window.innerWidth;
            height = canvas.height = window.innerHeight;
        });

        const particles = [];
        const maxSparkles = 25; // destellos ascendentes
        const maxPetals = 20;   // pétalos descendentes

        const sparkleColors = [
            'rgba(247, 231, 206, 0.4)', // Champagne
            'rgba(216, 185, 138, 0.3)', // Gold Soft
            'rgba(255, 246, 232, 0.45)'  // Pearl
        ];

        // Partículas ascendentes de destello
        class Sparkle {
            constructor() {
                this.reset();
                this.y = Math.random() * height;
            }

            reset() {
                this.x = Math.random() * width;
                this.y = height + 10;
                this.size = Math.random() * 1.8 + 0.4;
                this.speed = Math.random() * 0.35 + 0.15;
                this.color = sparkleColors[Math.floor(Math.random() * sparkleColors.length)];
                this.opacity = Math.random() * 0.4 + 0.15;
                this.fadeSpeed = Math.random() * 0.006 + 0.002;
                this.fadeDirection = Math.random() > 0.5 ? 1 : -1;
            }

            update() {
                this.y -= this.speed;
                this.opacity += this.fadeSpeed * this.fadeDirection;
                if (this.opacity >= 0.6) this.fadeDirection = -1;
                else if (this.opacity <= 0.1) this.fadeDirection = 1;

                if (this.y < -10) {
                    this.reset();
                }
            }

            draw() {
                ctx.beginPath();
                ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
                ctx.fillStyle = this.color.replace(/[\d\.]+\)$/, `${this.opacity})`);
                ctx.fill();
            }
        }

        // Hojas / Pétalos de oro descendentes
        class Petal {
            constructor() {
                this.reset();
                this.y = Math.random() * height;
            }

            reset() {
                this.x = Math.random() * width;
                this.y = -20;
                this.size = Math.random() * 12 + 6; // tamaño del pétalo
                this.w = this.size;
                this.h = this.size * (Math.random() * 0.3 + 0.65); // proporción de la hoja
                this.speedY = Math.random() * 0.7 + 0.3; // velocidad de caída lenta
                this.speedX = Math.random() * 0.6 - 0.3; // balanceo horizontal
                this.rotation = Math.random() * Math.PI * 2;
                this.rotationSpeed = (Math.random() * 0.015 - 0.0075);
                this.colorType = Math.random() > 0.55 ? 'oro' : 'champagne';
                this.opacity = Math.random() * 0.45 + 0.25;
                this.swingAngle = Math.random() * Math.PI;
                this.swingSpeed = Math.random() * 0.015 + 0.005;
            }

            update() {
                this.y += this.speedY;
                this.swingAngle += this.swingSpeed;
                this.x += this.speedX + Math.sin(this.swingAngle) * 0.4;
                this.rotation += this.rotationSpeed;

                // Interactividad física con el mouse
                const dx = this.x - mouse.x;
                const dy = this.y - mouse.y;
                const dist = Math.sqrt(dx * dx + dy * dy);
                if (dist < 100) {
                    const force = (100 - dist) / 100;
                    const angle = Math.atan2(dy, dx);
                    this.x += Math.cos(angle) * force * 4;
                    this.y += Math.sin(angle) * force * 4;
                }

                if (this.y > height + 20 || this.x < -20 || this.x > width + 20) {
                    this.reset();
                }
            }

            draw() {
                ctx.save();
                ctx.translate(this.x, this.y);
                ctx.rotate(this.rotation);

                const grad = ctx.createLinearGradient(-this.w/2, -this.h/2, this.w/2, this.h/2);
                if (this.colorType === 'oro') {
                    grad.addColorStop(0, `rgba(216, 185, 138, ${this.opacity})`);
                    grad.addColorStop(0.5, `rgba(255, 246, 232, ${this.opacity * 0.85})`);
                    grad.addColorStop(1, `rgba(230, 210, 181, ${this.opacity * 0.7})`);
                } else {
                    grad.addColorStop(0, `rgba(247, 231, 206, ${this.opacity})`);
                    grad.addColorStop(0.5, `rgba(216, 185, 138, ${this.opacity * 0.6})`);
                    grad.addColorStop(1, `rgba(255, 246, 232, ${this.opacity * 0.95})`);
                }

                ctx.fillStyle = grad;
                ctx.beginPath();
                // Dibujar forma de pétalo orgánico (doble curva cuadrática)
                ctx.moveTo(0, -this.h);
                ctx.quadraticCurveTo(this.w * 0.8, 0, 0, this.h);
                ctx.quadraticCurveTo(-this.w * 0.8, 0, 0, -this.h);
                ctx.closePath();
                ctx.fill();
                ctx.restore();
            }
        }

        // Inicializar arrays de partículas
        for (let i = 0; i < maxSparkles; i++) {
            particles.push(new Sparkle());
        }
        for (let i = 0; i < maxPetals; i++) {
            particles.push(new Petal());
        }

        // Loop principal de renderizado
        function animateParticles() {
            ctx.clearRect(0, 0, width, height);
            particles.forEach(p => {
                p.update();
                p.draw();
            });
            requestAnimationFrame(animateParticles);
        }

        animateParticles();

        // -------------------------
        // LÓGICA DE EFECTO 3D TILT EN GLASS CARDS
        // -------------------------
        const cards = document.querySelectorAll('.glass-card');
        
        cards.forEach(card => {
            // Capa interna para el brillo del cristal
            const shine = document.createElement('div');
            shine.className = 'card-shine';
            card.appendChild(shine);

            card.addEventListener('mousemove', (e) => {
                const rect = card.getBoundingClientRect();
                const x = e.clientX - rect.left;
                const y = e.clientY - rect.top;

                const centerX = rect.width / 2;
                const centerY = rect.height / 2;

                const maxRotate = 7; // Grados máximos de rotación
                const rotateX = ((centerY - y) / centerY) * maxRotate;
                const rotateY = ((x - centerX) / centerX) * maxRotate;

                card.style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) translateY(-4px)`;
                card.style.transition = 'none';

                // Posición dinámica del brillo radial
                const percentageX = (x / rect.width) * 100;
                const percentageY = (y / rect.height) * 100;
                shine.style.background = `radial-gradient(circle at ${percentageX}% ${percentageY}%, rgba(255, 246, 232, 0.12) 0%, rgba(255, 255, 255, 0) 65%)`;
            });

            card.addEventListener('mouseleave', () => {
                card.style.transform = `perspective(1000px) rotateX(0deg) rotateY(0deg) translateY(0px)`;
                card.style.transition = 'transform 0.6s cubic-bezier(0.16, 1, 0.3, 1)';
                shine.style.background = 'transparent';
            });
        });

        // -------------------------
        // OBSERVER PARA DIBUJAR SVG ORNAMENTALES AL SCROLL
        // -------------------------
        const svgObserver = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    const paths = entry.target.querySelectorAll('.draw-path');
                    paths.forEach(path => {
                        path.classList.add('animated');
                    });
                    svgObserver.unobserve(entry.target);
                }
            });
        }, { threshold: 0.15 });

        document.querySelectorAll('.ornament-svg').forEach(svg => {
            svgObserver.observe(svg);
        });
    </script>
</body>
</html>
